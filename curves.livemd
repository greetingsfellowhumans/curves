# Curves

```elixir
Mix.install(
  [
    {:curves, path: __DIR__, env: :dev},
    {:tucan, "~> 0.6.0"},
    {:vega_lite, "~> 0.1.0"},
    {:kino_vega_lite, "~> 0.1.0"},
    
  ],
  config_path: :curves,
  lockfile: :curves
)

# We'll use this as a helper for displaying graphs
print = fn points, label ->
  for i <- 0..1000 do
    {x, y} = Curves.solve!(points, i * 0.001)
    %{x: x, y: y, label: label}
  end
  |> Tucan.scatter("x", "y")
  |> Tucan.color_by("label")
end
```

## Curves tutorial

The basic cycle goes like this:

1. Define a curve with a list of {x, y} coordinates
2. Solve for y, given some percentage (t)

```elixir
curve = Curves.define_curve([
  {0, 0},
  {0, 0.5},
  {0.8, 0.4},
  {1, 1}
])


Curves.solve!(curve, 0.25)
```

```elixir
curve = Curves.define_curve([
  {0, 0},
  {100, 100}
])


# Using the helper we made way up at the very top of this Livebook ^
# We are actually printing 1000 dots between {0,0} and {100,100}
print.(curve, "Linear")
```

```elixir
curve = Curves.define_curve([
  {0, 50},
  {50, 0},
  {100, 50}
])

print.(curve, "Quadratic")
```

```elixir
curve = Curves.define_curve([
  {0, 0},
  {0.2, 0.8},
  {0.6, 0.3},
  {1, 1}
])

print.(curve, "Cubic")
```

```elixir
curve = Curves.define_curve([
  {0, 0},
  {0.2, 0.8},
  {0.6, 0.3},
  {1, 1}
])
curve2 = Curves.define_curve([
  {1, 1},
  {1.2, 1.8},
  {1.6, 1.3},
  {2, 2}
])
points1 = for i <- 0..1000 do
  {x, y} = Curves.solve!(curve, i * 0.001)
  %{x: x, y: y, label: "c1"}
end
points2 = for i <- 0..1000 do
  {x, y} = Curves.solve!(curve2, i * 0.001)
  %{x: x, y: y, label: "c2"}
end
points1 ++ points2
  |> Tucan.scatter("x", "y")
  |> Tucan.color_by("label")
```

```elixir
curve = Curves.define_curve([
  {0, 0},
  {0.2, 0.8},
  {0.6, 0.3},
  {1, 1},
  {1.2, 1.8},
  {1.6, 1.3},
  {2, 2}
])

Curves.solve!(curve, 0.5)
```
