# Splines (local development)

```elixir
# Local development copy: uses this repository instead of the Hex package.
Mix.install(
  [
    {:curves, path: Path.join(__DIR__, "../../"), env: :dev},
    {:kino, "~> 0.19"},
  ],
  config_path: :curves,
  lockfile: :curves
)
```

## Curves (Spline) tutorial

```elixir
# Each control point gets a dashed line to the knot it pulls the curve towards.
curve =
  Curves.define_bezier_spline([
    [{0, 0}, {2, 3}, {4, -3}],
    [{6, 0}, {8, 3}, {10, -3}],
    [{12, 0}]
  ])

curve
|> Curves.Svg.render(title: "Handle lines")
|> Kino.Image.new(:svg)
```

```elixir
# A very common spline is the Bezier Spline: a chain of Bezier curves,
# each one starting where the last one ended. Like an SVG path, each point
# is a knot, then the control points of the curve to the next knot:
#   [knot]          a straight line   (SVG L)
#   [knot, c]       a quadratic curve (SVG Q)
#   [knot, c0, c1]  a cubic curve     (SVG C)
# The last point only ends the curve, so it is just [knot].

curve = Curves.define_bezier_spline([
  [{5.0, 10.0}, {10.0, 10.0}, {5.0, 5.0}],
  [{10.0, 5.0}, {15.0, 5.0}, {15.0, 6.0}],
  [{15.0, 10.0}, {15.0, 14.0}, {18.0, 15.0}],
  [{20.0, 15.0}, {23.0, 15.0}, {32.0, 5.0}],
  [{30.0, 10.0}]
])

curve
|> Curves.Transform.inc_rotation(0)
|> Curves.Svg.render(width: 400, height: 400)
|> Kino.Image.new(:svg)
```

```elixir
curve = Curves.define_hermite([
  # [knot, tangent]
  [{5, 10}, {5, -5}],
  [{10, 5}, {5, 0}],
  [{15, 10}, {5, 5}],
  [{20, 10}, {5, -3}],
  [{25, 5}, {5, 5}],
  [{30, 15}, {5, 10}]
])


curve
|> Curves.Svg.render(width: 400, height: 400)
|> Kino.Image.new(:svg)
```

```elixir
curve = Curves.define_catmull_rom([
  {0, 0},
  {1, 0},
  {1, 1},
  {0, 1},
  {0, 2},
  {1, 2},
])


curve
|> Curves.Svg.render(width: 400, height: 400)
|> Kino.Image.new(:svg)
```

```elixir
curve = Curves.define_b_spline([
    {0, -2},
    {3, 4},
    {6, 5},
    {7, -1},
    {10, 3},
    {5, 1},
    {12, 9}
])


curve
|> Curves.Svg.render(width: 400, height: 400)
|> Kino.Image.new(:svg)
```
