# Bezier Curves Dev

```elixir
Mix.install(
  [
    {:curves, path: Path.join(__DIR__, "../"), env: :dev},
    {:kino, "~> 0.19"},
  ],
  config_path: :curves,
  lockfile: :curves
)
```

## Curves (Bezier) tutorial

```elixir
curve = Curves.define_b_spline([
    {0, -2},
    {3, 4},
    {6, 5},
    {7, -1},
    {10, 3},
    {5, 1},
    {12, 9}
])
Curves.solve!(curve, 0.5)
```

```elixir
curve = Curves.define_b_spline([
    {0, -2},
    {3, 4},
    {6, 5},
    {7, -1},
    {10, 3},
    {5, 1},
    {12, 9}
])


Curves.Svg.render(curve, 300)
|> Kino.Image.new(:svg)
```

```elixir
curve = Curves.define_catmull_rom([
  {0, 0},
  {1, 0},
  {1, 1},
  {0, 1},
  {0, 2},
  {1, 2},
])


curve
|> Curves.Svg.render(300, title: "Catmull-Rom", width: 400, height: 400)
|> Kino.Image.new(:svg)

```

```elixir
curve = Curves.define_hermite([
  {5, 10},
  {10, 5},
  {15, 10},
  {20, 10},
  {25, 5},
  {30, 15},
])


curve
|> Curves.Svg.render(300, title: "Hermite")
|> Kino.Image.new(:svg)
```

```elixir
# Before getting into the nitty gritty, let's start with a visual demo.
# Evaluate this code block, and select a curve type
types = Curves.Bezier.Predefined.list()
        |> Enum.map(&{&1, &1})

bezier_type = Kino.Input.select("Curve Type", types, default: :ease_in_out)

```

```elixir
# Now evaluate THIS code block to display a graph of the curve type you selected above.
Kino.Input.read(bezier_type)
|> Curves.define_bezier()
|> Curves.Transform.inc_position({1, 1})
#|> Curves.Transform.inc_position({-10, -10})
|> Curves.Transform.set_rotation(4)
#|> Curves.Transform.inc_position({10, 10})
|> Curves.Svg.render(300)
|> Kino.Image.new(:svg)


# Go ahead and play around with the select list to see the various predefined curves.
```

```elixir
# Done playing? Alright, let's start digging into what just happened.

# We always start off by defining a curve
curve = Curves.define_bezier(:ease_in)

# That's all it takes to define a bezier curve. Now we have a struct
is_struct(curve, Curves.Bezier.Curve)

# And we can easily find a point along the curve at a given percentage.
# `Curves.Svg.render/3` basically did that 300 times,
# and joined those points with straight lines so short they looked like one smooth curve.

# Conventionally, percentage in a bezier curve is represented as `t`
t = 0.2
{x, y} = Curves.solve!(curve, t)
```

```elixir
# Waaaaait a minute. if the graph is from 0.0 to 1.0, then why does't x == 0.2 at 20%?
#
# Well because `t` represents percentage of the *curves length*, not the *x axis*.
# (and the curve is actually longer than 1.0)
#
# Did that make no sense? Fair enough. Let's visualize it by lowering the sample count to 10.
# Each sample is 10% further along the curve, and the samples are joined by straight lines.
# Notice how those 10 straight pieces are not all the same length.
Curves.define_bezier(:ease_in_expo)
|> Curves.Svg.render(10)
|> Kino.Image.new(:svg)
```

```elixir
## Advanced Usage

# We can define our own curves manualy. 
# At a minimum, you can supply 2 points to get a linear 'curve'
curve = Curves.define_bezier([
  {0, 10},
  {1, 0}
])
#curve = Curves.define_bezier(:linear_down_right)

# We are actually solving 300 points between {0, 10} and {1, 0}, and joining them
curve
|> Curves.Svg.render(300, title: "Linear")
|> Kino.Image.new(:svg)
```

```elixir
# With 3 points, we get a quadratic curve
start = {0, 0}
control_point = {20, 50}
stop = {100, 0}

curve = Curves.define_bezier(:quadratic_right)

curve
|> Curves.Svg.render(300, title: "Quadratic")
|> Kino.Image.new(:svg)
```

```elixir
# And finally the one most people think of when they hear "bezier curve"; The cubic bezier.
curve = Curves.define_bezier([
  {0, 0},
  {0.8, 0.2},
  {0.3, 2.2},
  {1, 1}
])

curve = curve |> Curves.Transform.inc_y(2)
dbg curve
curve
|> Curves.Transform.inc_y(2)
|> Curves.Svg.render(300, title: "Cubic")
|> Kino.Image.new(:svg)
```

```elixir
# And finally the one most people think of when they hear "bezier curve"; The cubic bezier.

curve = Curves.define_bezier_spline([
  # P0
  [{5.0, 10.0},
  {10.0, 10.0}],

  # P1
  [{10.0, 5.0},
    {5.0, 5.0}, 
    {15.0, 5.0}],

  # P2
  [{15.0, 10.0},
   {15.0, 6.0},
   {15.0, 14.0}
  ],

  # P3
  [{20.0, 15.0},
   {18.0, 15.0},
   {23.0, 15.0}],

  [{30.0, 10.0}, 
    {32.0, 5.0}]
])

curve
|> Curves.Svg.render(1000, title: "Bezier spline")
|> Kino.Image.new(:svg)
```
